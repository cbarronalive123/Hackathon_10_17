# NoirStay — env template
# Copy to .env.local and fill in real values.

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/noirstay
SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_HEX

# Spur LLM (powers the concierge chat)
SPUR_API_KEY=sk-spur-...
SPUR_BASE_URL=https://ai.spuric.com/v1
SPUR_MODEL=spur-glm-5-3

# ElevenLabs (optional) — enables server-side speech-to-text and spoken replies.
# Without it, the site falls back to the browser's speech recognition.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Nuitee Connect (liteAPI) — live hotel inventory for the concierge chat.
# Free sandbox key: https://www.liteapi.travel/ (Developer -> API Keys)
LITEAPI_KEY=sand_...
